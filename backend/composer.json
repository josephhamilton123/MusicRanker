{
    "name": "trackrank/api",
    "description": "TrackRank scoring API",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S 127.0.0.1:8080 -t public public/router.php",
        "migrate": "php bin/migrate.php"
    }
}
